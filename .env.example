# Polymarket Copy Bot Configuration
# Copy this file to .env and fill in your values

# Fraction of the target's trade size to copy (0.5 = 50%)
SCALE_FACTOR=0.5

# Price filters (skip trades outside this range)
MAX_PRICE=0.95
MIN_PRICE=0.05

# Set to "false" to place real orders (requires credentials below)
DRY_RUN=true

# Thread pool size for handling simultaneous trades
MAX_WORKERS=10

# --- Required when DRY_RUN=false ---
PRIVATE_KEY=0x...
FUNDER_ADDRESS=0x...
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
